{
  "name": "nyxers-workflow-cloud-dev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nyxers Workflow Cloud Dev — AI-driven dev dashboard (terminal, copilot, device preview, templates, export, PWA) plus an MCP server for agentic tooling.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev --workspace packages/server",
    "dev:dashboard": "npm run dev --workspace packages/dashboard",
    "dev:mcp": "npm run dev --workspace packages/mcp-server",
    "start": "node server.js",
    "mobile:mcp": "node mobile-mcp.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "ws": "^8.18.3",
    "zod": "^3.25.0"
  }
}
